#!/usr/bin/env python3
"""
mc7401 — запуск эмулятора терминала «Электроника МС 7401».

Один исполняемый файл: без установки находит пакет `mc7401` рядом с
собой и запускает командную строку эмулятора.  Без аргументов
открывается интерактивный режим (диалог с терминалом):

    mc7401                       # интерактивный режим
    mc7401 поток.bin -o кадр.png # отрисовать поток команд
    mc7401 --help                # все режимы

Короткая команда `mc7401` — это этот же файл (символическая ссылка
в `~/.local/bin`); `Path(__file__).resolve()` доводит её до исходника,
поэтому пакет ищется в репозитории.
"""

from __future__ import annotations

import sys
from pathlib import Path


def main() -> int:
    # Исходное расположение: корень репозитория (работает и по ссылке).
    # Если файл скопирован в PATH (установка), пакет берётся из
    # установленного — site-packages.
    root = Path(__file__).resolve().parent.parent
    if (root / 'mc7401' / '__init__.py').is_file() and str(root) not in sys.path:
        sys.path.insert(0, str(root))
    from mc7401.cli import main as cli_main
    return cli_main()


if __name__ == '__main__':                             # pragma: no cover
    raise SystemExit(main())
